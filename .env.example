# Local development only: no authentication on admin routes yet.
DATABASE_PATH=./data/storyshorts.sqlite3
OUTPUT_DIR=./outputs
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
TTS_ENGINE=kokoro
KOKORO_VOICE=af_heart
AUTO_PUBLISH=false
# Reddit integration requires Reddit's approval appropriate to your use.
REDDIT_AUTHORIZED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=linux:storyshorts-studio:v0.1 (by /u/your-account)
YOUTUBE_TOKEN_FILE=./secrets/youtube_token.json
YOUTUBE_CLIENT_SECRETS_FILE=./secrets/client_secret.json
